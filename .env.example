DELAY_BETWEEN_ALERTS_SECONDS=2
TOKEN_REFRESH_BUFFER_MINUTES=5
RATE_LIMIT_BACKOFF_SECONDS=60
RATE_LIMIT_CAP_SECONDS=3600
HTTP_TIMEOUT_SECONDS=20
JISHAKU_HIDE=true
JISHAKU_NO_UNDERSCORE=true
JISHAKU_NO_DM_TRACEBACK=true
