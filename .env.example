APP_ENV=development
DISCORD_TOKEN=
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=
AUTO_SYNC_COMMANDS=true
SHARD_COUNT=
LOG_CHANNEL_ID=
GUILD_JOIN_LOG_CHANNEL_ID=
GUILD_LEAVE_LOG_CHANNEL_ID=
SHARD_LOG_WEBHOOK_URL=
SHARD_STATUS_CHANNEL_ID=
SUGGESTION_LOG_CHANNEL_ID=
SUPPORT_URL=
VOTE_URL=
WEBSITE_URL=
GLITCHTIP_DSN=
GLITCHTIP_TRACES_SAMPLE_RATE=0.1
GLITCHTIP_PROFILES_SAMPLE_RATE=0.1
GLITCHTIP_LOGS_ENABLED=true
LOG_URLS=false
VERBOSE_LOGGING=false
LINK_ITEM_IMAGE=true
USE_SHOP_CACHE=true
AUTO_REFRESH_TOKENS=true
MAX_ACCOUNTS_PER_USER=10
ALERTS_PER_PAGE=10
ALERT_CONCURRENCY=1
